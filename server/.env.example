DATABASE_URL="postgresql://user:password@localhost:5432/our_sweet_family"

# Clerk (authentication). Create an app at https://dashboard.clerk.com — see CLERK_SETUP.md.
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Storage: "local" or "s3"
STORAGE_PROVIDER="local"

# File storage: AWS S3 or Cloudflare R2 (S3-compatible)
AWS_BUCKET="your-bucket-name"
AWS_REGION="auto"
AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY="your-access-key-id"
AWS_SECRET_KEY="your-secret-access-key"
AWS_PUBLIC_URL="https://your-custom-domain-or-r2-dev-url"

PORT=3001
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Contact form — where submissions are emailed
CONTACT_TO="Contact@oursweetfamily.com"

# Outbound email.
# PREFERRED: Resend HTTP API (port 443 — works on hosts like Railway that block
# outbound SMTP). Set RESEND_API_KEY and a verified-domain From address.
RESEND_API_KEY=""
SMTP_FROM="Our Sweet Family <no-reply@oursweetfamily.com>"

# Fallback: SMTP (used only if RESEND_API_KEY is unset). Any provider.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Billing (RevenueCat). Shared secret sent as the webhook Authorization header —
# set the SAME value in the RevenueCat dashboard webhook config. The webhook is
# refused (503) until this is set. Optional overrides map RevenueCat entitlement
# identifiers to our plan tiers (defaults: "premium" / "plus").
REVENUECAT_WEBHOOK_SECRET=""
REVENUECAT_PREMIUM_ENTITLEMENT="premium"
REVENUECAT_PLUS_ENTITLEMENT="plus"

# Server-only key for RevenueCat REST v1 customer reconciliation. Never expose in client env.
REVENUECAT_API_KEY=""
# Enable only on an isolated sandbox backend; production must remain false.
REVENUECAT_ALLOW_SANDBOX="false"
