DATABASE_URL="postgresql://user:password@localhost:5432/our_sweet_family"

# Clerk (authentication). Create an app at https://dashboard.clerk.com — see CLERK_SETUP.md.
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Storage: "local" or "s3"
STORAGE_PROVIDER="local"

# File storage: AWS S3 or Cloudflare R2 (S3-compatible)
AWS_BUCKET="your-bucket-name"
AWS_REGION="auto"
AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY="your-access-key-id"
AWS_SECRET_KEY="your-secret-access-key"
AWS_PUBLIC_URL="https://your-custom-domain-or-r2-dev-url"

PORT=3001
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Contact form — where submissions are emailed
CONTACT_TO="Contact@oursweetfamily.com"

# Outbound email (SMTP). Works with any provider (SES, Resend, Mailgun, Postmark, Gmail…).
# If unset, contact messages are still saved to the database but NOT emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@oursweetfamily.com"
