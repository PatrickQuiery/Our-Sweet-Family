DATABASE_URL="postgresql://user:password@localhost:5432/our_sweet_family"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Storage: "local" or "s3"
STORAGE_PROVIDER="local"

# File storage: AWS S3 or Cloudflare R2 (S3-compatible)
AWS_BUCKET="your-bucket-name"
AWS_REGION="auto"
AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY="your-access-key-id"
AWS_SECRET_KEY="your-secret-access-key"
AWS_PUBLIC_URL="https://your-custom-domain-or-r2-dev-url"

PORT=3001
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# OAuth — Google Sign-In (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# OAuth — Apple Sign-In (https://developer.apple.com/account/resources/identifiers)
APPLE_CLIENT_ID="com.yourcompany.oursweetfamily"
