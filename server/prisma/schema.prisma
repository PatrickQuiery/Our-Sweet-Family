generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  loved_one
}

enum Plan {
  free
  plus
  premium
}

enum Permission {
  view_only
  upload
  share_download
  all
}

enum FileType {
  photo
  video
}

enum ReactionType {
  love
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  clerkUserId  String?  @unique  // Clerk subject; credentials/social live in Clerk
  passwordHash String?           // optional — Clerk owns passwords now
  name         String
  avatarUrl    String?
  role         Role     @default(loved_one)
  plan         Plan     @default(free)
  // A temporary plan boost (the referral reward grants Plus for 90 days). While
  // planBoostUntil is in the future, the user's EFFECTIVE plan is at least Plus.
  planBoostUntil DateTime?
  referralCode   String?  @unique  // this user's own share code
  createdAt    DateTime @default(now())

  ownedFamilies  Family[]       @relation("FamilyOwner")
  familyMembers  FamilyMember[]
  memories       Memory[]
  reactions      Reaction[]
  comments       Comment[]
  referralsMade    Referral[] @relation("ReferralsMade")
  referralReceived Referral?  @relation("ReferralReceived")
}

// One row per successful referral. refereeId is unique, so each new user can be
// credited to at most one referrer.
model Referral {
  id         String   @id @default(uuid())
  referrerId String
  refereeId  String   @unique
  status     String   @default("completed")
  createdAt  DateTime @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model Family {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  // Owner opt-in to SHOW photo location in the app. GPS is always captured and
  // stored (see Memory.latitude/longitude); this only controls visibility, and
  // even when on, location is shown to the owner only.
  showPhotoLocation Boolean @default(false)
  createdAt DateTime @default(now())

  owner       User           @relation("FamilyOwner", fields: [ownerId], references: [id])
  children    Child[]
  members     FamilyMember[]
  memories    Memory[]
  invitations Invitation[]
}

model Child {
  id          String   @id @default(uuid())
  familyId    String
  name        String
  dateOfBirth DateTime
  gender      String?
  avatarUrl   String?

  family     Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  milestones Milestone[]
}

model FamilyMember {
  id            String     @id @default(uuid())
  familyId      String
  userId        String
  permissions   Permission @default(view_only)
  accessPerChild Json       @default("\"all\"")
  createdAt     DateTime   @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

model Memory {
  id              String   @id @default(uuid())
  familyId        String
  childIds        Json     @default("[]")
  uploadedById    String
  fileUrl         String
  thumbnailUrl    String?
  fileType        FileType
  originalQuality Boolean  @default(false)
  capturedAt      DateTime
  isClassified    Boolean  @default(false)
  caption         String?
  // Location where the photo was taken, from EXIF GPS. SENSITIVE (can reveal a
  // home/school) — only ever exposed to the family owner, never to invited
  // members, never in the feed or a URL.
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())

  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id])
  reactions  Reaction[]
  comments   Comment[]
}

model Reaction {
  id        String       @id @default(uuid())
  memoryId  String
  userId    String
  type      ReactionType @default(love)
  createdAt DateTime     @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoryId, userId, type])
}

model Comment {
  id        String   @id @default(uuid())
  memoryId  String
  userId    String
  text      String
  createdAt DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Milestone {
  id        String   @id @default(uuid())
  childId   String
  type      String
  value     String
  unit      String?
  note      String?
  date      DateTime
  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
}

// Pending invitations for loved ones who don't yet have an account. A real User
// is only created when the invitee accepts and sets their own password.
model Invitation {
  id             String     @id @default(uuid())
  familyId       String
  email          String
  permissions    Permission @default(view_only)
  accessPerChild Json       @default("\"all\"")
  tokenHash      String     @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime   @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([email])
}

// Contact form submissions. Persisted so no message is lost even if the outbound
// email transport is misconfigured or temporarily unavailable.
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  userId    String?
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())
}
