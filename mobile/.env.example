# Public configuration only. Never place RevenueCat secret API keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_BASE_URL=https://your-api.example.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# App Store public appl_ key and Google Play public goog_ key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional shared test_ public key for development; per-platform keys override it.
EXPO_PUBLIC_REVENUECAT_KEY=

# Enable only in a dedicated sandbox build. Keep false for production releases.
EXPO_PUBLIC_REVENUECAT_ALLOW_SANDBOX=false
