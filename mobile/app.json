{
  "expo": {
    "name": "Our Sweet Family",
    "slug": "our-sweet-family",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "oursweetfamily",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oursweetfamily.app",
      "associatedDomains": [
        "applinks:oursweetfamily.com",
        "applinks:www.oursweetfamily.com"
      ]
    },
    "android": {
      "package": "com.oursweetfamily.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "oursweetfamily.com",
              "pathPrefix": "/accept-invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Our Sweet Family to access your photos to share memories.",
          "cameraPermission": "Allow Our Sweet Family to use the camera to capture memories.",
          "microphonePermission": "Allow Our Sweet Family to use the microphone when recording videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Our Sweet Family to access your photos so you can pick memories to share.",
          "savePhotosPermission": "Allow Our Sweet Family to save memories to your photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-emblem.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffdcea",
          "dark": {
            "image": "./assets/splash-emblem-white.png",
            "imageWidth": 240,
            "backgroundColor": "#1b2540"
          }
        }
      ]
    ]
  }
}
