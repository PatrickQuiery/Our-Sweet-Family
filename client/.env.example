# Clerk publishable key (from https://dashboard.clerk.com — see CLERK_SETUP.md)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# API base URL (the client calls <base>/api). Defaults to same-origin/dev proxy if unset.
VITE_API_BASE_URL=http://localhost:3001

# Public RevenueCat Web Billing SDK key (rcb_...). Never put a secret sk_ API key here.
# Keep empty until the Web Billing app, products and payment provider are configured.
VITE_REVENUECAT_WEB_KEY=
# Explicit opt-in for a test_ Test Store key on a dedicated test/preview build only.
VITE_REVENUECAT_ALLOW_SANDBOX=false
